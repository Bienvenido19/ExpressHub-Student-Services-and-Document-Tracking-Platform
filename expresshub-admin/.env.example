PORT=3000
NODE_ENV=development

# Database (XAMPP/MySQL defaults shown)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=expresshub

# Long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Email notifications (optional). If SMTP_HOST is empty, emails are only recorded in the email_log table.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="QCU Registrar <no-reply@yourdomain.edu.ph>"
